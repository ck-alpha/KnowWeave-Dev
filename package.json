{
  "name": "knowweave",
  "version": "0.1.0",
  "private": true,
  "description": "KnowWeave — local-first agent knowledge management with Qwen and traceable Wiki",
  "license": "MIT",
  "author": "ck-alpha",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "dev": "node scripts/local.mjs dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "start": "node scripts/local.mjs start",
    "doctor": "node scripts/local.mjs doctor",
    "setup:local": "node scripts/local.mjs setup",
    "data:scifact": "python3 scripts/scifact.py prepare",
    "demo:scifact": "python3 scripts/demo_scifact.py",
    "test:data": "python3 -m unittest discover -s tests -v"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "eslint": "^8.57.0",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "keytar"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ck-alpha/KnowWeave.git"
  },
  "homepage": "https://github.com/ck-alpha/KnowWeave#readme",
  "bugs": {
    "url": "https://github.com/ck-alpha/KnowWeave/issues"
  }
}
