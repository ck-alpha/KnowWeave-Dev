# Shell exports; scripts/local.mjs does not auto-load this file.
# Defaults below work from the checkout; all generated state is gitignored.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.8:27b
OLLAMA_NUM_CTX=32768
OLLAMA_NUM_PREDICT=4096
# KNOWWAEVE_WIKI_PATH=/absolute/path/to/wiki
# KNOWWAEVE_CONFIG_DIR=/absolute/path/to/config

# Local retrieval (independent from the Qwen generation model)
OLLAMA_EMBED_MODEL=nomic-embed-text:v1.5
OLLAMA_EMBED_NUM_CTX=8192
OLLAMA_EMBED_TIMEOUT_MS=120000
